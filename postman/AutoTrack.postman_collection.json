          "mode": "raw",
          "raw": "{\n  \"vin\": \"1HGCM82633A004352\",\n  \"placa\": \"DEMO123\",\n  \"kilometrajeActual\": 48000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set(\"vehiculoId\", pm.response.json().data.id);",
              "pm.test(\"VIN guardado\", function () { pm.expect(pm.response.json().data.vin).to.equal(\"1HGCM82633A004352\"); });"
            ]
          }
        }
